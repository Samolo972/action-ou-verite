# Port HTTP local (nginx fait le proxy depuis 443)
PORT=3004
# URL publique du site (sert aux liens d'invitation et aux balises Open Graph)
PUBLIC_URL=https://jeu.example.com
# Origine(s) autorisée(s) pour CORS / Socket.IO, séparées par des virgules
ALLOWED_ORIGIN=https://jeu.example.com
NODE_ENV=production
