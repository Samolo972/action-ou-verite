# /etc/nginx/sites-available/av.samuel-josephmyrtil.fr
# Reverse proxy vers Node (port 3004) avec support WebSocket.
# Certbot ajoute lui-même le bloc HTTPS (listen 443 + certificats) avec : certbot --nginx -d av.samuel-josephmyrtil.fr

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name av.samuel-josephmyrtil.fr;

    # Pas de logs d'accès : aucune donnée personnelle conservée.
    access_log off;

    client_max_body_size 16k;

    # Socket.IO (WebSocket + repli long-polling)
    location /socket.io/ {
        proxy_pass http://127.0.0.1:3004;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location / {
        proxy_pass http://127.0.0.1:3004;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
